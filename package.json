{
  "name": "openanimator",
  "productName": "OpenAnimator",
  "version": "0.1.0",
  "description": "Estudio open source para crear videos animados con HTML/SVG, IA (Claude) y exportación por GPU (NVENC).",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "npm run build:main && vite build && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "npm run build && node scripts/package.mjs",
    "build:iphone": "node scripts/build-iphone.mjs",
    "build:ios": "node scripts/build-iphone.mjs --native"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@noble/hashes": "^2.4.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "acorn": "^8.18.0",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "electron": "^44.4.5",
    "es-module-lexer": "^3.0.2",
    "esbuild": "^0.28.2",
    "events": "^3.3.0",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "mediabunny": "^1.61.0",
    "memfs": "^4.80.0",
    "path-browserify": "^1.0.1",
    "readable-stream": "^4.7.0",
    "semver": "^7.8.5",
    "smol-toml": "^1.9.0",
    "string_decoder": "^1.3.0",
    "typescript": "^7.0.2",
    "util": "^0.12.5",
    "vite": "^8.3.1",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "modern-screenshot": "^4.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
