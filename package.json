{
  "name": "openanimator",
  "productName": "OpenAnimator",
  "version": "0.1.0",
  "description": "Estudio open source para crear videos animados con HTML/SVG, IA (Claude) y exportación por GPU (NVENC).",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "npm run build:main && vite build && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "modern-screenshot": "^4.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
